# =============================================================================
# Online Cinema: environment variables
# Copy this file to `.env` and fill in the values:  cp .env_sample .env
# Never commit the real `.env` file.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=online_cinema
POSTGRES_DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# Use `localhost` when running the app on your machine,
# or the database service name (e.g. `db`) when running inside Docker.
POSTGRES_HOST=localhost

# --- JWT ----------------------------------------------------------------------
# Secret used to sign access tokens. Generate a long random value, for example:
#   openssl rand -hex 32
JWT_SECRET_KEY=change_me

# --- Redis (Celery broker and result backend) ---------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- SMTP (email sending) -----------------------------------------------------
# For local development MailHog works without a login: host `localhost`, port 1025.
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Stripe (payments, test mode only) ----------------------------------------
# Test keys from the Stripe dashboard (they start with `sk_test_` / `whsec_`).
# Never put live keys here.
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# Dev defaults for the local MinIO (change them outside local development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=avatars
MINIO_PUBLIC_URL=http://localhost:9000